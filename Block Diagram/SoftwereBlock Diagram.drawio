        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n  subgraph userLayer[\&quot;1. ผู้ใช้และช่องทางสั่งงาน\&quot;]\n    direction TB\n    student[\&quot;Student: ผู้ขับตามเวลา AI GPS และ Geofence\&quot;]\n    employee[\&quot;Employee: ผู้ขับตามเงื่อนไขที่กำหนด\&quot;]\n    manager[\&quot;Manager: ผู้ขับและดูแลงานปฏิบัติการ\&quot;]\n    admin[\&quot;Admin: จัดการระบบและไม่ใช่บัญชีผู้ขับ\&quot;]\n    channel[\&quot;Web หรือ NFC: Start Pause Resume End\&quot;]\n    student --&gt; channel\n    employee --&gt; channel\n    manager --&gt; channel\n    admin --&gt; channel\n  end\n\n  subgraph webLayer[\&quot;2. Responsive Web Application\&quot;]\n    direction TB\n    webApp[\&quot;Web App: Login Register Approval Pre-ride และคำสั่ง Session\&quot;]\n    userView[\&quot;My Trips: สถานะ ประวัติ การแจ้งเตือน และคำร้องทบทวน\&quot;]\n    operations[\&quot;Operations Dashboard: Vehicle GPS BMS AI Network และ Alerts\&quot;]\n    phoneGps[\&quot;Phone GPS: สำรองเฉพาะตรวจ Return Zone\&quot;]\n  end\n\n  subgraph cloudLayer[\&quot;3. Supabase Cloud\&quot;]\n    direction TB\n    authService[\&quot;Auth และ RLS: Identity Role Account Status และ Driving Permission\&quot;]\n    commandService[\&quot;Edge Functions: Online Authorization Signature Nonce TTL และ Anti-replay\&quot;]\n    sessionService[\&quot;Reservation และ Session Engine: Atomic Claim และ State Control\&quot;]\n    policyService[\&quot;Policy และ Safety Rules: Role Time AI GPS Geofence BMS และ Restrictions\&quot;]\n    realtimeService[\&quot;Realtime และ HTTPS APIs: Commands Status Telemetry และ Alerts\&quot;]\n    reviewService[\&quot;Alerts Notifications และ Review Workflow\&quot;]\n    privacyService[\&quot;Audit Privacy Retention Version History และ Deletion\&quot;]\n    systemDb[(\&quot;PostgreSQL: Users NFC Vehicles Reservations Sessions GPS BMS AI Events Commands และ Audit\&quot;)]\n  end\n\n  subgraph vehicleBoundary[\&quot;4. จุดเชื่อมต่อระบบบนรถ\&quot;]\n    vehicleGateway[\&quot;Raspberry Pi 4G Gateway: Vehicle API Client\&quot;]\n  end\n\n  channel --&gt;|\&quot;HTTPS\&quot;| webApp\n  webApp --&gt;|\&quot;Sign in\&quot;| authService\n  webApp --&gt;|\&quot;Session commands\&quot;| commandService\n  userView &lt;--&gt;|\&quot;History and notices\&quot;| realtimeService\n  operations &lt;--&gt;|\&quot;Live operations\&quot;| realtimeService\n  phoneGps -.-&gt;|\&quot;Return check\&quot;| policyService\n\n  authService --&gt;|\&quot;Identity and permission\&quot;| sessionService\n  commandService &lt;--&gt;|\&quot;Atomic transition\&quot;| sessionService\n  policyService --&gt;|\&quot;Eligibility result\&quot;| sessionService\n  sessionService &lt;--&gt;|\&quot;Session state\&quot;| systemDb\n  realtimeService &lt;--&gt;|\&quot;Status and telemetry\&quot;| systemDb\n  reviewService &lt;--&gt;|\&quot;Incidents and reviews\&quot;| systemDb\n  privacyService &lt;--&gt;|\&quot;Retention and audit\&quot;| systemDb\n\n  commandService &lt;--&gt;|\&quot;Signed commands and result\&quot;| vehicleGateway\n  realtimeService &lt;--&gt;|\&quot;Telemetry and events\&quot;| vehicleGateway\n\n  onlineRule[\&quot;กฎหลัก: การเริ่ม Session ใหม่ต้องออนไลน์เสมอ\&quot;]\n  singleUserRule[\&quot;กฎหลัก: รถหนึ่งคันมี Reservation หรือ Active Session ได้หนึ่งผู้ใช้\&quot;]\n  adminRule[\&quot;Admin จัดการบัญชี สิทธิ์ NFC Geofence และ OUT OF SERVICE แต่ห้ามข้าม Safety Interlock\&quot;]\n\n  sessionService -.-&gt; onlineRule\n  sessionService -.-&gt; singleUserRule\n  admin -.-&gt; adminRule\n\n  classDef actor fill:#FDF4FF,stroke:#E879F9,color:#701A75,stroke-width:1px\n  classDef web fill:#ECFEFF,stroke:#22D3EE,color:#164E63,stroke-width:2px\n  classDef cloud fill:#FFF7ED,stroke:#A78BFA,color:#4C1D95,stroke-width:2px\n  classDef database fill:#F5F3FF,stroke:#8B5CF6,color:#4C1D95,stroke-width:2px\n  classDef boundary fill:#ECFDF5,stroke:#34D399,color:#065F46,stroke-width:2px\n  classDef safety fill:#FFF1F2,stroke:#FB7185,color:#881337,stroke-width:2px\n\n  class student,employee,manager,admin,channel actor\n  class webApp,userView,operations,phoneGps web\n  class authService,commandService,sessionService,policyService,realtimeService,reviewService,privacyService cloud\n  class systemDb database\n  class vehicleGateway boundary\n  class onlineRule,singleUserRule,adminRule safety\n\n  style userLayer fill:#FDF4FF,stroke:#E879F9,stroke-width:1px\n  style webLayer fill:#ECFEFF,stroke:#22D3EE,stroke-width:1px\n  style cloudLayer fill:#FFF7ED,stroke:#FDBA74,stroke-width:1px\n  style vehicleBoundary fill:#ECFDF5,stroke:#34D399,stroke-width:1px\n\n  linkStyle default stroke:#475569,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="AzqTb-FgPItPfBem4iZ7-1">
