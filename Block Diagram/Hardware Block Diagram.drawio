        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n  subgraph cloudBoundary[\&quot;1. Cloud Interface\&quot;]\n    cloudLink[\&quot;Supabase: Signed Commands Realtime Telemetry และ Events\&quot;]\n  end\n\n  subgraph piLayer[\&quot;2. Raspberry Pi 5 RAM 4GB - Gateway และ AI\&quot;]\n    direction TB\n    lteGateway[\&quot;4G LTE Gateway: ช่องทางอินเทอร์เน็ตเดียวของรถ\&quot;]\n    cloudClient[\&quot;Cloud Client และ Sync: HTTPS Realtime Sequence Manifest และ ACK\&quot;]\n    aiEngine[\&quot;YOLO Segmentation และ IMU Fusion: Lane Departure และ Near Shoulder\&quot;]\n    piHealth[\&quot;Runtime Health: Camera AI Network และ Timestamp\&quot;]\n    camera[\&quot;Camera Module 3 Wide\&quot;]\n    imu[\&quot;MPU6050 IMU\&quot;]\n  end\n\n  subgraph espLayer[\&quot;3. ESP32-S3 - Edge Safety Controller\&quot;]\n    direction TB\n    uartHandler[\&quot;UART Protocol: COBS CRC-32C ACK Retry และ Idempotency\&quot;]\n    commandVerify[\&quot;Command Verification: Signature Nonce TTL และ Anti-replay\&quot;]\n    safetyInterlock[\&quot;Safety Interlock: Stationary Throttle Zero BMS AI GPS Proximity และ Motor Ready\&quot;]\n    sensorLogic[\&quot;Sensor และ Geofence Logic: NFC GNSS BMS Main Geofence และ Return Zone\&quot;]\n    audioOffline[\&quot;Audio และ Offline Store: Thai Priority Queue และ Persistent Data\&quot;]\n  end\n\n  subgraph physicalLayer[\&quot;4. Sensors Actuators และ Vehicle Native\&quot;]\n    direction TB\n    nfcReader[\&quot;PN532 NFC: UID และ Enrollment\&quot;]\n    gnssModule[\&quot;ATGM336H GNSS: Position Time และ Fix Quality\&quot;]\n    vehicleBms[\&quot;Vehicle BMS: SoC Charging และ Fault\&quot;]\n    safetyInputs[\&quot;Vehicle Inputs: Stationary Speed State และ Throttle Zero\&quot;]\n    localStorage[\&quot;Flash หรือ SD: Offline Data และ Audio Files\&quot;]\n    audioHardware[\&quot;MAX98357A และ Weather-resistant Speaker\&quot;]\n    motorController[\&quot;VOTOL EM100: Keyless E-lock Enable และ Motor Ready Feedback\&quot;]\n    hubMotor[\&quot;QS 2000W Hub Motor: ผู้ขับควบคุมด้วยตนเอง\&quot;]\n    powerSystem[\&quot;Vehicle Battery และ DC-DC: แยกการป้องกัน Pi LTE ESP32 และ Audio\&quot;]\n  end\n\n  subgraph safetyLayer[\&quot;5. Safety Constraints และ Pending Verification\&quot;]\n    noOfflineStart[\&quot;ห้ามเริ่ม Session ใหม่เมื่อ Cloud หรือ 4G ใช้งานไม่ได้\&quot;]\n    noCutoff[\&quot;4G Pi หรือ AI หายระหว่าง Active ต้องไม่ตัดกำลังมอเตอร์กะทันหัน\&quot;]\n    geofenceRule[\&quot;ออกนอก Main Geofence ให้แจ้งเตือนและบันทึกเท่านั้น\&quot;]\n    pendingWork[\&quot;ต้องทดสอบ VOTOL Interface Motor Ready OFF Proximity Stationary Sensing UART และ Fail-safe\&quot;]\n  end\n\n  cloudLink &lt;--&gt;|\&quot;4G HTTPS and Realtime\&quot;| lteGateway\n  lteGateway --&gt; cloudClient\n  cloudClient &lt;--&gt;|\&quot;UART commands telemetry and config\&quot;| uartHandler\n\n  camera --&gt; aiEngine\n  imu --&gt; aiEngine\n  aiEngine --&gt;|\&quot;AI event and health\&quot;| uartHandler\n  piHealth --&gt; uartHandler\n\n  uartHandler &lt;--&gt;|\&quot;Command and ACK\&quot;| commandVerify\n  commandVerify --&gt;|\&quot;Verified authorization\&quot;| safetyInterlock\n  sensorLogic --&gt;|\&quot;Local conditions\&quot;| safetyInterlock\n  sensorLogic --&gt;|\&quot;NFC GPS and BMS telemetry\&quot;| uartHandler\n  uartHandler --&gt;|\&quot;AI and system alerts\&quot;| audioOffline\n\n  nfcReader --&gt;|\&quot;UID\&quot;| sensorLogic\n  gnssModule --&gt;|\&quot;Position and fix\&quot;| sensorLogic\n  vehicleBms --&gt;|\&quot;SoC charge and fault\&quot;| sensorLogic\n  safetyInputs --&gt;|\&quot;Stationary and throttle\&quot;| safetyInterlock\n  audioOffline &lt;--&gt;|\&quot;Persistent log and replay\&quot;| localStorage\n  audioOffline --&gt;|\&quot;I2S audio\&quot;| audioHardware\n  safetyInterlock &lt;--&gt;|\&quot;Motor Ready and feedback\&quot;| motorController\n  motorController --&gt;|\&quot;Native motor drive\&quot;| hubMotor\n\n  powerSystem -.-&gt; lteGateway\n  powerSystem -.-&gt; uartHandler\n  powerSystem -.-&gt; audioHardware\n\n  cloudClient -.-&gt; noOfflineStart\n  piHealth -.-&gt; noCutoff\n  sensorLogic -.-&gt; geofenceRule\n  safetyInterlock -.-&gt; pendingWork\n\n  classDef cloud fill:#FFF7ED,stroke:#A78BFA,color:#4C1D95,stroke-width:2px\n  classDef pi fill:#ECFDF5,stroke:#34D399,color:#065F46,stroke-width:2px\n  classDef esp fill:#F5F3FF,stroke:#A78BFA,color:#4C1D95,stroke-width:2px\n  classDef hardware fill:#F0FDF4,stroke:#4ADE80,color:#14532D,stroke-width:1px\n  classDef control fill:#FFF7ED,stroke:#FB923C,color:#9A3412,stroke-width:2px\n  classDef safety fill:#FFF1F2,stroke:#FB7185,color:#881337,stroke-width:2px\n\n  class cloudLink cloud\n  class lteGateway,cloudClient,aiEngine,piHealth,camera,imu pi\n  class uartHandler,commandVerify,safetyInterlock,sensorLogic,audioOffline esp\n  class nfcReader,gnssModule,vehicleBms,safetyInputs,localStorage,audioHardware,powerSystem hardware\n  class motorController,hubMotor control\n  class noOfflineStart,noCutoff,geofenceRule,pendingWork safety\n\n  style cloudBoundary fill:#FFF7ED,stroke:#FDBA74,stroke-width:1px\n  style piLayer fill:#ECFDF5,stroke:#34D399,stroke-width:1px\n  style espLayer fill:#F5F3FF,stroke:#A78BFA,stroke-width:1px\n  style physicalLayer fill:#FEF2F2,stroke:#F87171,stroke-width:1px\n  style safetyLayer fill:#FFF1F2,stroke:#FB7185,stroke-width:1px\n\n  linkStyle default stroke:#475569,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vqggYPkTJWYo6Da1hdrN-49">
